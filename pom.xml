<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.mzpeak</groupId>
  <artifactId>mzpeakj-parent</artifactId>
  <version>0.11.1</version>
  <packaging>pom</packaging>

  <name>mzPeakJ (parent)</name>
  <description>Reactor of mzPeakJ: the mzPeak library (mzpeakj/) and the mzML converter (mzpeakj-mzml/).</description>
  <url>https://github.com/okohlbacher/mzPeakJ</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>mzpeakj</module>
    <module>mzpeakj-mzml</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <parquet.version>1.18.2</parquet.version>
    <jackson.version>2.23.0</jackson.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <jacoco.version>0.8.16</jacoco.version>
    <!-- Set by jacoco:prepare-agent; empty so surefire's @{argLine} still resolves with -Djacoco.skip=true. -->
    <argLine/>
  </properties>

  <dependencies>
    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- zstd-jni loads a bundled native library; opt in to silence the JDK 25 warning.
                 @{argLine} carries the JaCoCo agent set by jacoco:prepare-agent. -->
            <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <!-- Self-contained runnable jar of each module: <artifactId>-<version>-all.jar, so examples/CLI run with
             `java -cp mzpeakj/target/mzpeakj-<version>-all.jar org.mzpeak.cli.MzPeakInfo ...` (no classpath
             assembly). A module activates it by naming the plugin in its <plugins>. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
          <executions>
            <execution>
              <phase>package</phase>
              <goals><goal>shade</goal></goals>
              <configuration>
                <shadedArtifactAttached>true</shadedArtifactAttached>
                <shadedClassifierName>all</shadedClassifierName>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                  <!-- Licence and notice texts of the bundled libraries (mzML design 2.1). A file that several jars
                       ship under one name is concatenated instead of kept once; the Apache NOTICE files are merged.
                       The first transformer that takes a resource wins, so the appending ones come first. -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/LICENSE</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/LICENSE.txt</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/LICENSE.md</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/NOTICE.txt</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/NOTICE.md</resource>
                  </transformer>
                  <!-- jackson-core and parquet-jackson ship different texts under this name -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/FastDoubleParser-LICENSE</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                    <addHeader>false</addHeader>
                  </transformer>
                  <!-- This project's licence and notice, and the licence texts of the bundled libraries whose jars
                       carry none (licenses/), under names no dependency uses: META-INF/LICENSE.<file name>. -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.mzpeakj</resource>
                    <file>${project.basedir}/../LICENSE</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/NOTICE.mzpeakj</resource>
                    <file>${project.basedir}/../NOTICE</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.Apache-2.0.txt</resource>
                    <file>${project.basedir}/../licenses/Apache-2.0.txt</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.BSD-2-Clause-zstd-jni.txt</resource>
                    <file>${project.basedir}/../licenses/BSD-2-Clause-zstd-jni.txt</file>
                  </transformer>
                  <!-- zstd compiled into the native libraries of zstd-jni; snappy and bitshuffle compiled into the
                       native libraries of snappy-java -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.BSD-3-Clause-zstd.txt</resource>
                    <file>${project.basedir}/../licenses/BSD-3-Clause-zstd.txt</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.BSD-3-Clause-snappy.txt</resource>
                    <file>${project.basedir}/../licenses/BSD-3-Clause-snappy.txt</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.MIT-bitshuffle.txt</resource>
                    <file>${project.basedir}/../licenses/MIT-bitshuffle.txt</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.MIT-slf4j.txt</resource>
                    <file>${project.basedir}/../licenses/MIT-slf4j.txt</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.EPL-2.0.txt</resource>
                    <file>${project.basedir}/../licenses/EPL-2.0.txt</file>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                    <resource>META-INF/LICENSE.EDL-1.0-jts.txt</resource>
                    <file>${project.basedir}/../licenses/EDL-1.0-jts.txt</file>
                  </transformer>
                </transformers>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                      <exclude>module-info.class</exclude>
                      <exclude>META-INF/versions/*/module-info.class</exclude>
                    </excludes>
                  </filter>
                </filters>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Test coverage, inherited by both modules: instruments only the project's own classes, so no JDK or
           third-party class is touched, writes <module>/target/site/jacoco/ (index.html, jacoco.xml, jacoco.csv)
           during verify and then fails the build unless every org.mzpeak class of the module is fully covered
           (check execution below). Coverage evidence comes from `clean verify` only: prepare-agent appends to
           target/jacoco.exec, so a run without clean can report an earlier run's coverage. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <!-- agent class-name patterns (the report goal's includes are file paths, so not set there) -->
              <includes>
                <include>org.mzpeak.*</include>
                <include>ms.numpress.*</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <formats>
                <format>HTML</format>
                <format>XML</format>
                <format>CSV</format>
              </formats>
            </configuration>
          </execution>
          <!-- Coverage gate, after report so that the report is there to read when it fails. -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <!-- Every org.mzpeak package, so every org.mzpeak class: no missed line, branch or method.
                     No org.mzpeak class is excluded. -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>org.mzpeak</include>
                    <include>org.mzpeak.*</include>
                  </includes>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.0000</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.0000</minimum></limit>
                    <limit><counter>METHOD</counter><value>COVEREDRATIO</value><minimum>1.0000</minimum></limit>
                  </limits>
                </rule>
                <!-- Vendored ms.numpress (library only; vacuous in the converter), which stays byte-identical, at
                     exactly the coverage reached: 207 of 208 lines, 131 of 132 branches, 16 of 16 methods. The gap
                     is MSNumpress.java line 73-74 in decode(String, byte[], int): the true branch of
                     `if (nbrOfDoubles < 0)` and its `throw new IllegalArgumentException("Corrupt numPic data!")`.
                     decodePic never returns a negative count, so no input reaches it. -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>ms.numpress</include>
                  </includes>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.9951</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.9924</minimum></limit>
                    <limit><counter>METHOD</counter><value>COVEREDRATIO</value><minimum>1.0000</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The reactor root holds no sources: a src/ here (left over from a merge of a pre-module branch, say) would
           silently not be built. Every module refuses Jackson and AssertJ versions below the chosen ones: the
           advisories are fixed on several release branches, so the floor is the chosen version itself
           (jackson-annotations, versioned without a patch number, is left out). parquet-hadoop's snappy-java and
           aircompressor are floored at their first fixed versions, parquet-jackson (a shaded Jackson) at the parquet
           release that shades a fixed Jackson. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>no-vulnerable-versions</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- also transitively, in every scope -->
                  <excludes>
                    <exclude>com.fasterxml.jackson.core:jackson-core:(,2.23.0)</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-databind:(,2.23.0)</exclude>
                    <exclude>org.assertj:assertj-core:(,3.27.7)</exclude>
                    <exclude>org.xerial.snappy:snappy-java:(,1.1.10.9)</exclude>
                    <exclude>io.airlift:aircompressor:(,2.0.3)</exclude>
                    <exclude>org.apache.parquet:parquet-jackson:(,1.18.2)</exclude>
                  </excludes>
                  <message>a version with a known advisory; see docs/design-decisions.md, D-1</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>no-sources-at-root</id>
            <inherited>false</inherited>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireFilesDontExist>
                  <files>
                    <file>${project.basedir}/src</file>
                  </files>
                  <message>sources belong in mzpeakj/ or mzpeakj-mzml/</message>
                </requireFilesDontExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

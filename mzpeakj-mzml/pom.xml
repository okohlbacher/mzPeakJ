<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mzpeak</groupId>
    <artifactId>mzpeakj-parent</artifactId>
    <version>0.11.0</version>
  </parent>

  <artifactId>mzpeakj-mzml</artifactId>
  <packaging>jar</packaging>

  <name>mzPeakJ mzML converter</name>
  <description>An mzML &lt;-&gt; mzPeak converter through jmzML 1.7.11: MzMLReader, MzMLWriter, MzMLConversion and the CLI MzPeakConvert.</description>

  <!-- jmzML and its parent POMs are published only here (mzML design 2.1). The id is the one the artifacts in the
       local repository were resolved with; a checksum mismatch fails the build. -->
  <repositories>
    <repository>
      <id>ebi-repo</id>
      <url>https://www.ebi.ac.uk/Tools/maven/repos/content/groups/ebi-repo/</url>
      <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- The library, used through its public API only. -->
    <dependency>
      <groupId>org.mzpeak</groupId>
      <artifactId>mzpeakj</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- jmzML as is: MzMLUnmarshaller reads, MzMLMarshaller writes, BinaryDataArray decodes and encodes. Kept from
         its tree: xxindex (the byte index of the input) and fastutil (CharOpenHashSet in EscapingXMLUtilities).
         Excluded: logback (known CVEs, a second SLF4J binding) and the other SLF4J artifacts (the library brings
         slf4j-api and slf4j-nop 1.7.33), the JAXB 2.2.7 artifacts (replaced by jaxb-runtime below), cpdetector,
         chardet, commons-collections and commons-codec (not loaded on the paths used), commons-io 2.6 (known CVEs,
         replaced below). Since commons-collections and cpdetector are excluded, MzMLUnmarshaller.isOkFileChecksum()
         (CircularFifoBuffer) and xxindex's StandardXmlElementExtractor throw NoClassDefFoundError: never call
         them. -->
    <dependency>
      <groupId>uk.ac.ebi.jmzml</groupId>
      <artifactId>jmzml</artifactId>
      <version>1.7.11</version>
      <exclusions>
        <exclusion><groupId>ch.qos.logback</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>org.slf4j</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>com.sun.xml.bind</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>javax.xml.bind</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>com.sun.istack</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>net.sourceforge.cpdetector</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>org.mozilla.intl</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>commons-collections</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>commons-codec</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>commons-io</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- CountingInputStream for xxindex, instead of the 2.6 it declares. -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.22.0</version>
    </dependency>
    <!-- The JAXB 2 runtime for the javax.xml.bind API jmzML is compiled against (Java 11+ ships none). -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.9</version>
    </dependency>

    <!-- Test: the library's test helpers (Fixtures, ContentDigest, ChildJvm, ...); their fixtures stay in
         mzpeakj/src/test/resources (surefire property mzpeak.test.resources below). -->
    <dependency>
      <groupId>org.mzpeak</groupId>
      <artifactId>mzpeakj</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- mzpeakj-mzml-<version>-all.jar (configuration in the parent POM). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
      <!-- Guards the exclusions of jmzML above: its pride-logging parent POM declares logback-core, logback-classic
           and jcl-over-slf4j, which must stay out, and so must every other logging framework, SLF4J binding or
           bridge (jmzML's logging goes, like the library's, to slf4j-api with slf4j-nop). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-logging-frameworks</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- groupId patterns (every artifact of the group) or groupId:artifactId, also transitively -->
                  <excludes>
                    <exclude>ch.qos.logback</exclude>
                    <exclude>commons-logging</exclude>
                    <exclude>org.slf4j:jcl-over-slf4j</exclude>
                    <exclude>log4j</exclude>
                    <exclude>org.apache.logging.log4j</exclude>
                    <exclude>ch.qos.reload4j</exclude>
                    <exclude>org.slf4j:slf4j-simple</exclude>
                    <exclude>org.slf4j:slf4j-jdk14</exclude>
                    <exclude>org.slf4j:slf4j-log4j12</exclude>
                    <exclude>org.slf4j:slf4j-reload4j</exclude>
                    <exclude>org.slf4j:log4j-over-slf4j</exclude>
                    <exclude>org.slf4j:jul-to-slf4j</exclude>
                  </excludes>
                  <message>mzpeakj-mzml must not depend on a logging framework, SLF4J binding or bridge other than slf4j-api and slf4j-nop (keep jmzML's org.slf4j and ch.qos.logback exclusions)</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- root of the library's fixtures, read by org.mzpeak.io.Fixtures -->
            <mzpeak.test.resources>${project.basedir}/../mzpeakj/src/test/resources</mzpeak.test.resources>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

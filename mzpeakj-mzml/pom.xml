<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mzpeak</groupId>
    <artifactId>mzpeakj-parent</artifactId>
    <version>0.11.1</version>
  </parent>

  <artifactId>mzpeakj-mzml</artifactId>
  <packaging>jar</packaging>

  <name>mzPeakJ mzML converter</name>
  <description>An mzML &lt;-&gt; mzPeak converter through jmzML 1.7.11: MzMLReader, MzMLWriter, MzMLConversion and the CLI MzPeakConvert.</description>

  <!-- jmzML and its parent POMs are published only here (mzML design 2.1). The id is the one the artifacts in the
       local repository were resolved with; a checksum mismatch fails the build. Three more guards (design D-2):
       the resolver's group filter (.mvn/maven.config, .mvn/rrf/groupId-ebi-repo.txt) lets this repository serve only
       uk.ac.ebi.jmzml, uk.ac.ebi.pride.architectural and psidev.psi.tools and denies every repository the
       dependency POMs declare; the resolver's trusted checksums (.mvn/checksums) pin the SHA-512 and SHA-1 of
       every artifact this repository serves: the jmzML jar and POM, the xxindex 0.23 jar and POM and the parent POMs
       pride-core 1.0.1, pride-logging 1.0.0 and pride-xml-handling 1.0.3 (list in .mvn/rrf/README.md); and
       JmzmlArtifactTest (JUnit) pins the SHA-256 of the jmzML jar on the test classpath.
       tools/check-repo-policy.sh checks on a fresh local repository that only central and this repository, for
       those groups, download anything. -->
  <repositories>
    <repository>
      <id>ebi-repo</id>
      <url>https://www.ebi.ac.uk/Tools/maven/repos/content/groups/ebi-repo/</url>
      <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- The library, used through its public API only. -->
    <dependency>
      <groupId>org.mzpeak</groupId>
      <artifactId>mzpeakj</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- jmzML as is: MzMLUnmarshaller reads, MzMLMarshaller writes, BinaryDataArray decodes and encodes. Kept from
         its tree: xxindex (the byte index of the input) and fastutil (CharOpenHashSet in EscapingXMLUtilities).
         Excluded: logback (known CVEs, a second SLF4J binding) and the other SLF4J artifacts (the library brings
         slf4j-api and slf4j-nop 1.7.33), the JAXB 2.2.7 artifacts (replaced by jaxb-runtime below), cpdetector,
         chardet, commons-collections and commons-codec (not loaded on the paths used), commons-io 2.6 (known CVEs,
         replaced below). Since commons-collections and cpdetector are excluded, MzMLUnmarshaller.isOkFileChecksum()
         (CircularFifoBuffer) and xxindex's StandardXmlElementExtractor throw NoClassDefFoundError: never call
         them. -->
    <dependency>
      <groupId>uk.ac.ebi.jmzml</groupId>
      <artifactId>jmzml</artifactId>
      <version>1.7.11</version>
      <exclusions>
        <exclusion><groupId>ch.qos.logback</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>org.slf4j</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>com.sun.xml.bind</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>javax.xml.bind</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>com.sun.istack</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>net.sourceforge.cpdetector</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>org.mozilla.intl</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>commons-collections</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>commons-codec</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>commons-io</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- CountingInputStream for xxindex, instead of the 2.6 it declares. -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.22.0</version>
    </dependency>
    <!-- The JAXB 2 runtime for the javax.xml.bind API jmzML is compiled against (Java 11+ ships none). -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.9</version>
    </dependency>

    <!-- Test: the library's test helpers (Fixtures, ContentDigest, ChildJvm, ...); their fixtures stay in
         mzpeakj/src/test/resources (surefire property mzpeak.test.resources below). -->
    <dependency>
      <groupId>org.mzpeak</groupId>
      <artifactId>mzpeakj</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- mzpeakj-mzml-<version>-all.jar (configuration in the parent POM), runnable with `java -jar` (design D-3):
           the manifest names the CLI and enables native access for zstd-jni and snappy-java (JDK 22+ warns
           otherwise). Of fastutil only the 81 classes jmzML needs are kept: EscapingXMLUtilities references
           it.unimi.dsi.fastutil.chars.CharOpenHashSet, the only fastutil class jmzML or xxindex reference, and the
           list below is its transitive closure inside fastutil 6.5.1, from
             jdeps -filter:none -verbose:class fastutil-6.5.1.jar
           (the edges `A -> B` with both in it.unimi.dsi.fastutil, followed from CharOpenHashSet). Not minimizeJar,
           which would also drop the classes JAXB, parquet and Jackson load by reflection. ExecutableJarIT checks the
           count. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>default</id>
            <configuration>
              <transformers combine.children="append">
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.mzpeak.mzml.cli.MzPeakConvert</mainClass>
                  <manifestEntries>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters combine.children="append">
                <filter>
                  <artifact>it.unimi.dsi:fastutil</artifact>
                  <includes>
                    <include>it/unimi/dsi/fastutil/Arrays.class</include>
                    <include>it/unimi/dsi/fastutil/BidirectionalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/Hash.class</include>
                    <include>it/unimi/dsi/fastutil/Hash$Strategy.class</include>
                    <include>it/unimi/dsi/fastutil/HashCommon.class</include>
                    <include>it/unimi/dsi/fastutil/Stack.class</include>
                    <include>it/unimi/dsi/fastutil/Swapper.class</include>
                    <include>it/unimi/dsi/fastutil/booleans/BooleanArrays.class</include>
                    <include>it/unimi/dsi/fastutil/booleans/BooleanArrays$1.class</include>
                    <include>it/unimi/dsi/fastutil/booleans/BooleanArrays$ArrayHashStrategy.class</include>
                    <include>it/unimi/dsi/fastutil/booleans/BooleanComparator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharBidirectionalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharCollection.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharList.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharList$1.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharList$CharSubList.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharList$CharSubList$1.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharListIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/AbstractCharSet.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharArrayList.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharArrayList$1.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharArrays.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharArrays$1.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharArrays$ArrayHashStrategy.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharBidirectionalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharCollection.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharComparator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterable.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$ArrayIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$EmptyIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$IntervalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$IteratorConcatenator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$IteratorWrapper.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$ListIteratorWrapper.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$SingletonIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$UnmodifiableBidirectionalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$UnmodifiableIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharIterators$UnmodifiableListIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharList.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharListIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharOpenHashSet.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharOpenHashSet$1.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharOpenHashSet$SetIterator.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharSet.class</include>
                    <include>it/unimi/dsi/fastutil/chars/CharStack.class</include>
                    <include>it/unimi/dsi/fastutil/ints/IntArrays.class</include>
                    <include>it/unimi/dsi/fastutil/ints/IntArrays$1.class</include>
                    <include>it/unimi/dsi/fastutil/ints/IntArrays$ArrayHashStrategy.class</include>
                    <include>it/unimi/dsi/fastutil/ints/IntComparator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectBidirectionalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectCollection.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectList.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectList$1.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectList$ObjectSubList.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectList$ObjectSubList$1.class</include>
                    <include>it/unimi/dsi/fastutil/objects/AbstractObjectListIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectArrayList.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectArrayList$1.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectArrays.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectArrays$1.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectArrays$ArrayHashStrategy.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectBidirectionalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectCollection.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterable.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$ArrayIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$EmptyIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$IteratorConcatenator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$IteratorWrapper.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$ListIteratorWrapper.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$SingletonIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$UnmodifiableBidirectionalIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$UnmodifiableIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectIterators$UnmodifiableListIterator.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectList.class</include>
                    <include>it/unimi/dsi/fastutil/objects/ObjectListIterator.class</include>
                  </includes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Guards the exclusions of jmzML above: its pride-logging parent POM declares logback-core, logback-classic
           and jcl-over-slf4j, which must stay out, and so must every other logging framework, SLF4J binding or
           bridge (jmzML's logging goes, like the library's, to slf4j-api with slf4j-nop). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-logging-frameworks</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- groupId patterns (every artifact of the group) or groupId:artifactId, also transitively -->
                  <excludes>
                    <exclude>ch.qos.logback</exclude>
                    <exclude>commons-logging</exclude>
                    <exclude>org.slf4j:jcl-over-slf4j</exclude>
                    <exclude>log4j</exclude>
                    <exclude>org.apache.logging.log4j</exclude>
                    <exclude>ch.qos.reload4j</exclude>
                    <exclude>org.slf4j:slf4j-simple</exclude>
                    <exclude>org.slf4j:slf4j-jdk14</exclude>
                    <exclude>org.slf4j:slf4j-log4j12</exclude>
                    <exclude>org.slf4j:slf4j-reload4j</exclude>
                    <exclude>org.slf4j:log4j-over-slf4j</exclude>
                    <exclude>org.slf4j:jul-to-slf4j</exclude>
                  </excludes>
                  <message>mzpeakj-mzml must not depend on a logging framework, SLF4J binding or bridge other than slf4j-api and slf4j-nop (keep jmzML's org.slf4j and ch.qos.logback exclusions)</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- root of the library's fixtures, read by org.mzpeak.io.Fixtures -->
            <mzpeak.test.resources>${project.basedir}/../mzpeakj/src/test/resources</mzpeak.test.resources>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- ExecutableJarIT runs the -all jar of package with `java -jar` (design D-3). The test JVM gets the surefire
           options, so @{argLine} carries the JaCoCo agent; the jar's child JVMs run no instrumented code. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <mzpeak.test.resources>${project.basedir}/../mzpeakj/src/test/resources</mzpeak.test.resources>
            <mzpeak.mzml.all.jar>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</mzpeak.mzml.all.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
